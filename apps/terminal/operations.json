{
  "schema": "motion.terminal.operations.v1",
  "note": "Operation inventory and parity ledger. Entries with status shared run through internal/operations from both interfaces; their api methods may not be called directly by internal/cli or internal/tui. Entries with status pending are tracked migration work, not parity claims. See PARITY.md.",
  "operations": [
    {
      "id": "session.connect",
      "workflow": "session",
      "status": "shared",
      "shared": ["Connect", "Settings", "Session"],
      "api": [],
      "cli": "server status",
      "tui": "motion tui receives the verified session from the same pathway",
      "capabilities": [],
      "tests": {
        "operations": ["internal/operations:TestConnectBindsCredentialsToTheVerifiedIdentity"],
        "cli": ["internal/cli:TestChangedServerIdentityNeverReceivesTheCredential", "internal/cli:TestKnownServerIDAtANewURLGetsNoCredential"],
        "tui": ["internal/cli:TestTUIReceivesTheVerifiedSharedSessionAndBrowser"]
      }
    },
    {
      "id": "jobs.list",
      "workflow": "jobs",
      "status": "shared",
      "shared": ["ListJobs", "CollectJobs", "Collect"],
      "api": ["ListJobs"],
      "cli": "jobs list",
      "tui": "Processing page and Overview work list",
      "capabilities": [],
      "tests": {
        "operations": ["internal/operations:TestJobListsKeepPaginationAndTruncationExplicit", "internal/operations:TestCollectRejectsARepeatedCursor"],
        "cli": ["internal/cli:TestJobsListAndShowUseTheSharedReads", "internal/cli:TestInvalidJobInputIsRejectedBeforeAnyRequest"],
        "tui": ["internal/tui:TestRetryReviewsTheJobAndSendsThatRevision", "internal/tui:TestJobCancellationAsksFirstAndSendsOneKeyedRequest"]
      }
    },
    {
      "id": "jobs.inspect",
      "workflow": "jobs",
      "status": "shared",
      "shared": ["InspectJob"],
      "api": ["GetJob"],
      "cli": "jobs show",
      "tui": "Processing page: enter on a job",
      "capabilities": [],
      "tests": {
        "operations": ["internal/operations:TestJobActionsCarryOneKeyPerIntentAndTheReviewedRevision"],
        "cli": ["internal/cli:TestJobsListAndShowUseTheSharedReads"],
        "tui": ["internal/tui:TestInspectShowsTheJobsCurrentState"]
      }
    },
    {
      "id": "jobs.cancel",
      "workflow": "jobs",
      "status": "shared",
      "shared": ["NewJobAction", "ResumeJobAction", "SubmitJobAction", "PendingJobActions", "UncertainError"],
      "api": ["CancelJob"],
      "cli": "jobs cancel",
      "tui": "Processing page: c, then confirm",
      "capabilities": ["processing:request (server selects per job kind)"],
      "tests": {
        "operations": ["internal/operations:TestLostAcknowledgementIsUncertainAndResubmissionAppliesOnce", "internal/operations:TestOutcomeClassification", "internal/operations:TestResumedKeysAndInputsAreValidated"],
        "cli": ["internal/cli:TestCancelWithLostAcknowledgementReportsTheKeyAndResubmitsOnce", "internal/cli:TestInvalidJobInputIsRejectedBeforeAnyRequest"],
        "tui": ["internal/tui:TestUnconfirmedCancellationIsResubmittedWithItsKey", "internal/tui:TestJobReplyAfterSignOutIsIgnored", "internal/tui:TestCancellationIsLeftToTheServer"]
      }
    },
    {
      "id": "jobs.retry",
      "workflow": "jobs",
      "status": "shared",
      "shared": ["NewJobAction", "ResumeJobAction", "SubmitJobAction", "PendingJobActions", "InspectJob"],
      "api": ["RetryJob"],
      "cli": "jobs retry",
      "tui": "Processing page: R reviews the job, then confirm",
      "capabilities": ["processing:request (server selects per job kind)"],
      "tests": {
        "operations": ["internal/operations:TestJobActionsCarryOneKeyPerIntentAndTheReviewedRevision", "internal/operations:TestStaleReviewIsAConflictNotASilentOverwrite"],
        "cli": ["internal/cli:TestJobsRetryCommandUsesFreshOperationIdentityAndReportsConflicts", "internal/cli:TestRetryCarriesTheGivenRevisionAndReportsAStaleOne", "internal/cli:TestUncertainOutcomeIsExplainedInHumanOutput"],
        "tui": ["internal/tui:TestRetryReviewsTheJobAndSendsThatRevision", "internal/tui:TestRetryOfAChangedJobIsRefusedNotRefetched"]
      }
    },
    {
      "id": "playback.launch",
      "workflow": "playback",
      "status": "shared",
      "shared": ["LaunchPlayer", "PlayerURL", "PlaybackReady", "Browser"],
      "api": [],
      "cli": "play",
      "tui": "p on a title or item",
      "capabilities": ["playback:request", "feature playback.v2"],
      "tests": {
        "operations": ["internal/operations:TestLaunchPlayerChecksCapabilityAndOpensOneTokenFreeURL", "internal/operations:TestPlayerURLHasOnlyEscapedSelection"],
        "cli": ["internal/cli:TestPlayUsesTheSharedLaunchAndTheInjectedBrowser"],
        "tui": ["internal/tui:TestPlaybackLaunchUsesNoCredentialAndRequiresCapability"]
      }
    },
